# Browser-visible API origin. Use the local backend URL for development.
VITE_API_URL=http://localhost:8000/api

# Use "mock" to run against local sample data; "real" sends requests to VITE_API_URL.
VITE_API_MODE=real
VITE_MOCK_LATENCY=off

# Optional public Google OAuth client ID. Never put private credentials here.
VITE_GOOGLE_CLIENT_ID=
